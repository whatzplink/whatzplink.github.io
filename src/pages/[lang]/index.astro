---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroGeneratorBox from '../../components/HeroGeneratorBox.astro';
import BelowFoldContent from '../../components/BelowFoldContent.astro';
import { languages, defaultLang, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({
      params: { lang },
    }));
}

const { lang } = Astro.params as { lang: Lang };
---

<BaseLayout lang={lang}>
  <HeroGeneratorBox lang={lang} />
  <BelowFoldContent lang={lang} />
</BaseLayout>
