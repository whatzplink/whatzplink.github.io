---
import { type Lang, useTranslations, getLocalizedPath } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const baseUrl = (Astro.site ? Astro.site.toString() : 'https://whatzplink.github.io').replace(/\/$/, '');
const pageUrl = `${baseUrl}${getLocalizedPath(lang)}`;

// STRICT COMPLIANCE: Zero fake AggregateRating or Review schemas.
const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${pageUrl}#webapp`,
      name: 'WhatzpLink',
      url: 'https://whatzplink.github.io/',
      inLanguage: lang,
      description: t.meta.description,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'All',
      browserRequirements: 'Requires JavaScript and HTML5 Canvas.',
      offers: {
        '@type': 'Offer',
        price: '0.00',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'HowTo',
      '@id': `${pageUrl}#howto`,
      name: t.howTo.schemaName,
      description: t.howTo.subtitle,
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: t.howTo.step1Title,
          text: t.howTo.step1Desc,
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: t.howTo.step2Title,
          text: t.howTo.step2Desc,
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: t.howTo.step3Title,
          text: t.howTo.step3Desc,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: [
        {
          '@type': 'Question',
          name: t.faq.q1,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.faq.a1,
          },
        },
        {
          '@type': 'Question',
          name: t.faq.q2,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.faq.a2,
          },
        },
        {
          '@type': 'Question',
          name: t.faq.q3,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.faq.a3,
          },
        },
        {
          '@type': 'Question',
          name: t.faq.q4,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.faq.a4,
          },
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t.breadcrumbs.home,
          item: 'https://whatzplink.github.io/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: t.breadcrumbs.tools,
          item: `${pageUrl}#business-tools`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: t.breadcrumbs.generator,
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
