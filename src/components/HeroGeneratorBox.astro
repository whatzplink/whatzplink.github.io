---
import { type Lang, useTranslations } from '../i18n/ui';
import { COUNTRIES } from '../data/countries';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  aria-labelledby="hero-primary-h1"
  class="min-h-[calc(100dvh-72px)] flex flex-col justify-center px-4 py-8 sm:px-6 md:py-12 mx-auto max-w-4xl"
>
  <!-- Clean, Focused Hero Heading -->
  <div class="text-center mb-6 sm:mb-8">
    <h1
      id="hero-primary-h1"
      style="font-size: clamp(1.85rem, 4vw, 3rem); line-height: 1.15;"
      class="font-extrabold tracking-tight text-[#1A2E15] dark:text-[#FFF8CF] flex flex-wrap items-center justify-center gap-3"
    >
      <span
        class="inline-flex h-12 w-12 sm:h-14 sm:w-14 shrink-0 items-center justify-center rounded-2xl bg-[#2A7C13] text-[#FFFFFF] shadow-md"
        aria-hidden="true"
      >
        <svg class="h-7 w-7 sm:h-8 sm:w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          <path d="M8 12h8" />
          <path d="M12 8v8" />
        </svg>
      </span>
      <span>{t.hero.h1}</span>
    </h1>
    <p class="mt-2.5 text-base sm:text-lg md:text-xl font-medium text-[#3B5234] dark:text-[#FBE6C2] max-w-2xl mx-auto">
      {t.hero.subtitle}
    </p>
  </div>

  <!-- Main Simple Generator Card -->
  <div
    id="generator-workspace-box"
    class="w-full max-w-2xl mx-auto rounded-3xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FFFFFF] dark:bg-[#1B2E17] p-5 sm:p-7 md:p-8 shadow-workspace transition-all duration-300"
  >
    <form id="wa-generator-form" class="space-y-6" novalidate>
      <!-- 1. Country Code & Phone Number -->
      <div class="space-y-2.5">
        <label
          for="wa-phone-input"
          class="block text-base sm:text-lg font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]"
        >
          {t.generator.step1Label}
        </label>

        <div class="flex flex-col sm:flex-row gap-3">
          <!-- Searchable Country Code Selector -->
          <div class="relative w-full sm:w-44 shrink-0" id="country-selector-wrapper">
            <button
              type="button"
              id="country-selector-btn"
              aria-label={t.generator.step1Label}
              aria-haspopup="listbox"
              aria-expanded="false"
              class="flex h-14 w-full items-center justify-between gap-2 rounded-2xl border-2 border-[#76C457] focus:border-[#2A7C13] bg-[#FFF8CF] dark:bg-[#152412] px-4 text-left text-lg font-extrabold text-[#1A2E15] dark:text-[#FFF8CF] transition-all hover:border-[#2A7C13] focus:outline-none focus:ring-2 focus:ring-[#2A7C13]"
            >
              <span id="selected-country-display" class="flex items-center gap-2 truncate">
                <span class="inline-flex items-center justify-center rounded-md bg-[#2A7C13] px-1.5 py-0.5 text-xs font-extrabold text-[#FFFFFF]">US</span>
                <span>+1</span>
              </span>
              <svg class="h-5 w-5 shrink-0 text-[#2A7C13] dark:text-[#76C457]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </button>

            <!-- Dropdown Panel -->
            <div
              id="country-dropdown-panel"
              class="hidden absolute left-0 mt-2 w-full sm:w-80 rounded-2xl border-2 border-[#2A7C13] bg-[#FFFFFF] dark:bg-[#1B2E17] p-2.5 shadow-2xl z-40"
            >
              <input
                type="text"
                id="country-search-input"
                aria-label={t.generator.countrySearchPlaceholder}
                placeholder={t.generator.countrySearchPlaceholder}
                autocomplete="off"
                class="w-full rounded-xl border-2 border-[#76C457] focus:border-[#2A7C13] bg-[#FFF8CF] dark:bg-[#152412] px-3.5 py-2.5 text-sm sm:text-base font-semibold text-[#1A2E15] dark:text-[#FFF8CF] placeholder-[#3B5234]/70 dark:placeholder-[#FBE6C2]/60 focus:outline-none mb-2"
              />
              <ul
                id="country-list"
                role="listbox"
                class="max-h-60 overflow-y-auto divide-y divide-[#FBE6C2]/50 dark:divide-[#243B1F]"
              >
                {
                  COUNTRIES.map((c) => (
                    <li
                      role="option"
                      data-dial={c.dial}
                      data-flag={c.flag}
                      data-iso={c.code}
                      data-name={c.name.toLowerCase()}
                      data-code={c.code.toLowerCase()}
                      class="country-option-item flex cursor-pointer items-center justify-between rounded-xl px-3 py-2.5 text-sm sm:text-base font-bold text-[#1A2E15] dark:text-[#FFF8CF] hover:bg-[#FBE6C2] dark:hover:bg-[#243B1F] transition-colors"
                    >
                      <span class="flex items-center gap-2.5 truncate">
                        <span class="inline-flex w-8 shrink-0 items-center justify-center rounded bg-[#FBE6C2] dark:bg-[#243B1F] px-1.5 py-0.5 text-xs font-extrabold text-[#2A7C13] dark:text-[#76C457]">
                          {c.code}
                        </span>
                        <span class="truncate">{c.name}</span>
                      </span>
                      <span class="ml-2 rounded-lg bg-[#FFF8CF] dark:bg-[#152412] px-2 py-0.5 text-xs sm:text-sm font-extrabold text-[#2A7C13] dark:text-[#76C457]">
                        +{c.dial}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <!-- Phone Number Input -->
          <div class="relative flex-1">
            <input
              type="tel"
              id="wa-phone-input"
              inputmode="tel"
              placeholder={t.generator.phonePlaceholder}
              aria-describedby="phone-validation-badge"
              class="h-14 w-full rounded-2xl border-2 border-[#76C457] focus:border-[#2A7C13] bg-[#FFF8CF] dark:bg-[#152412] px-4 text-lg sm:text-xl font-extrabold tracking-wide text-[#1A2E15] dark:text-[#FFF8CF] placeholder-[#3B5234]/50 dark:placeholder-[#FBE6C2]/40 transition-all focus:outline-none focus:ring-2 focus:ring-[#2A7C13]"
            />
          </div>
        </div>

        <!-- Subtle Validation Status (Hidden until user types or clicks Create) -->
        <div
          id="phone-validation-badge"
          role="status"
          aria-live="polite"
          data-ready={t.generator.validationReady}
          data-cleaned={t.generator.validationCleaned}
          data-empty={t.generator.validationEmpty}
          data-invalid={t.generator.validationInvalid}
          class="hidden items-center gap-2 rounded-xl bg-[#FBE6C2]/80 dark:bg-[#243B1F] px-3.5 py-2 text-xs sm:text-sm font-bold text-[#1A2E15] dark:text-[#FFF8CF]"
        >
          <span
            id="validation-icon-dot"
            class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#2A7C13] text-xs text-[#FFFFFF]"
          >
            ✓
          </span>
          <span id="validation-status-text">{t.generator.validationReady}</span>
        </div>
      </div>

      <!-- 2. Custom Pre-filled Message (Optional) -->
      <div class="space-y-2.5">
        <label
          for="wa-message-input"
          class="block text-base sm:text-lg font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]"
        >
          {t.generator.step2Label}
        </label>
        <textarea
          id="wa-message-input"
          rows="3"
          placeholder={t.generator.messagePlaceholder}
          class="w-full rounded-2xl border-2 border-[#76C457] focus:border-[#2A7C13] bg-[#FFF8CF] dark:bg-[#152412] p-4 text-base sm:text-lg font-semibold text-[#1A2E15] dark:text-[#FFF8CF] placeholder-[#3B5234]/55 dark:placeholder-[#FBE6C2]/45 transition-all focus:outline-none focus:ring-2 focus:ring-[#2A7C13] resize-y"
        ></textarea>

        <!-- Clean 1-Click Quick Message Chips -->
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 pt-1">
          <span class="text-xs font-extrabold uppercase tracking-wider text-[#3B5234] dark:text-[#FBE6C2] mr-1">
            {t.generator.quickChipsLabel}
          </span>
          <button
            type="button"
            data-chip-text={t.generator.chipOrderText}
            class="quick-chip-btn rounded-full border border-[#76C457] bg-[#FBE6C2]/70 dark:bg-[#243B1F] px-3 py-1 text-xs sm:text-sm font-bold text-[#1A2E15] dark:text-[#FFF8CF] transition-all hover:bg-[#2A7C13] hover:text-[#FFFFFF] hover:border-[#2A7C13] active:scale-95"
          >
            🛒 {t.generator.chipOrder}
          </button>
          <button
            type="button"
            data-chip-text={t.generator.chipInfoText}
            class="quick-chip-btn rounded-full border border-[#76C457] bg-[#FBE6C2]/70 dark:bg-[#243B1F] px-3 py-1 text-xs sm:text-sm font-bold text-[#1A2E15] dark:text-[#FFF8CF] transition-all hover:bg-[#2A7C13] hover:text-[#FFFFFF] hover:border-[#2A7C13] active:scale-95"
          >
            💬 {t.generator.chipInfo}
          </button>
          <button
            type="button"
            data-chip-text={t.generator.chipBookText}
            class="quick-chip-btn rounded-full border border-[#76C457] bg-[#FBE6C2]/70 dark:bg-[#243B1F] px-3 py-1 text-xs sm:text-sm font-bold text-[#1A2E15] dark:text-[#FFF8CF] transition-all hover:bg-[#2A7C13] hover:text-[#FFFFFF] hover:border-[#2A7C13] active:scale-95"
          >
            📅 {t.generator.chipBook}
          </button>
          <button
            type="button"
            data-chip-text={t.generator.chipQuoteText}
            class="quick-chip-btn rounded-full border border-[#76C457] bg-[#FBE6C2]/70 dark:bg-[#243B1F] px-3 py-1 text-xs sm:text-sm font-bold text-[#1A2E15] dark:text-[#FFF8CF] transition-all hover:bg-[#2A7C13] hover:text-[#FFFFFF] hover:border-[#2A7C13] active:scale-95"
          >
            💼 {t.generator.chipQuote}
          </button>
        </div>
      </div>

      <!-- 3. Primary "Create Link" CTA Button -->
      <button
        type="submit"
        id="create-link-submit-btn"
        class="w-full flex min-h-[60px] items-center justify-center gap-3 rounded-2xl bg-[#2A7C13] px-6 py-4 text-lg sm:text-xl font-extrabold text-[#FFFFFF] shadow-lg transition-all duration-200 hover:shadow-emerald-glow hover:ring-2 hover:ring-[#76C457] active:scale-[0.99] focus:outline-none focus:ring-4 focus:ring-[#76C457]"
      >
        <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
        </svg>
        <span>{t.hero.modeCreate}</span>
      </button>
    </form>

    <!-- REVEALED DETAILS SECTION (Hidden initially; smoothly shown when user clicks Create Link) -->
    <div
      id="generated-results-section"
      class="hidden mt-8 pt-7 border-t-2 border-[#76C457]/60 dark:border-[#2A7C13] space-y-6 animate-bubble-pop"
    >
      <!-- Generated Link Readout + Primary Actions -->
      <div class="rounded-2xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FFF8CF] dark:bg-[#152412] p-4 sm:p-5 space-y-4">
        <div class="space-y-2">
          <span class="block text-xs sm:text-sm font-extrabold uppercase tracking-wider text-[#2A7C13] dark:text-[#76C457]">
            {t.generator.readoutLabel}
          </span>
          <code
            id="generated-url-readout"
            role="status"
            aria-live="polite"
            aria-atomic="true"
            class="block w-full break-all rounded-xl border-2 border-[#76C457] bg-[#FFFFFF] dark:bg-[#1B2E17] px-4 py-3 font-mono text-sm sm:text-base font-extrabold text-[#1A2E15] dark:text-[#FFF8CF] select-all"
          >
            https://wa.me/12345678900
          </code>
        </div>

        <!-- Accessible Copied Notification Banner -->
        <div
          id="copy-notification-banner"
          role="status"
          aria-live="polite"
          aria-atomic="true"
          class="hidden rounded-xl bg-[#2A7C13] px-4 py-2.5 text-center text-sm font-extrabold text-[#FFFFFF] shadow-sm transition-all"
        >
          {t.generator.copiedLinkBtn}
        </div>

        <!-- Action Buttons (Responsive across Mobile, Tablet, Desktop) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <!-- Copy Link Button -->
          <button
            type="button"
            id="copy-wa-link-btn"
            aria-label={t.generator.copyLinkBtn}
            data-copy-text={t.generator.copyLinkBtn}
            data-copied-text={t.generator.copiedLinkBtn}
            class="flex min-h-[54px] h-auto items-center justify-center gap-2.5 rounded-2xl bg-[#2A7C13] px-5 py-3 text-base font-extrabold leading-snug text-[#FFFFFF] shadow-md transition-all duration-200 hover:shadow-emerald-glow hover:ring-2 hover:ring-[#76C457] active:scale-98"
          >
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <span id="copy-btn-label" aria-live="polite">{t.generator.copyLinkBtn}</span>
          </button>

          <!-- Test Link in WhatsApp Button -->
          <a
            id="test-wa-link-btn"
            href="https://wa.me/12345678900"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.generator.testWhatsappBtn}
            class="flex min-h-[54px] h-auto items-center justify-center gap-2.5 rounded-2xl border-2 border-[#2A7C13] bg-[#FBE6C2] dark:bg-[#243B1F] px-5 py-3 text-base font-extrabold leading-snug text-[#1A2E15] dark:text-[#FFF8CF] shadow-sm transition-all duration-200 hover:bg-[#2A7C13] hover:text-[#FFFFFF] hover:shadow-emerald-glow active:scale-98"
          >
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
            <span>{t.generator.testWhatsappBtn}</span>
          </a>
        </div>
      </div>

      <!-- QR Code + Live Chat Preview Grid (Responsive 1-col on mobile, 2-col on tablet/desktop) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-stretch">
        <!-- QR Code Card -->
        <div
          class="flex flex-col items-center justify-between gap-4 rounded-2xl border-2 border-[#2A7C13] bg-[#FFF8CF] dark:bg-[#152412] p-5 text-center"
        >
          <div class="space-y-1">
            <h2 class="text-lg font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]">
              {t.generator.qrTitle}
            </h2>
            <p class="text-xs sm:text-sm font-semibold text-[#3B5234] dark:text-[#FBE6C2]">
              {t.generator.qrSubtitle}
            </p>
          </div>

          <div class="flex items-center justify-center rounded-2xl border-4 border-[#2A7C13] bg-[#FFFFFF] p-3 shadow-md">
            <canvas
              id="wa-qr-canvas"
              width="200"
              height="200"
              aria-label="WhatsApp Link QR Code"
              class="h-40 w-40 sm:h-44 sm:w-44 rounded-lg"
            ></canvas>
          </div>

          <!-- Download QR Buttons (PNG + SVG) -->
          <div class="flex flex-wrap items-center justify-center gap-2.5 w-full">
            <button
              type="button"
              id="download-qr-png-btn"
              aria-label={t.generator.downloadQrPngBtn}
              class="flex-1 min-h-[44px] inline-flex items-center justify-center gap-2 rounded-xl bg-[#2A7C13] px-4 py-2.5 text-sm font-extrabold text-[#FFFFFF] shadow-sm transition-all hover:shadow-emerald-glow"
            >
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              <span>PNG</span>
            </button>

            <button
              type="button"
              id="download-qr-svg-btn"
              aria-label={t.generator.downloadQrSvgBtn}
              class="flex-1 min-h-[44px] inline-flex items-center justify-center gap-2 rounded-xl border-2 border-[#2A7C13] bg-[#FBE6C2] dark:bg-[#243B1F] px-4 py-2.5 text-sm font-extrabold text-[#1A2E15] dark:text-[#FFF8CF] transition-all hover:bg-[#2A7C13] hover:text-[#FFFFFF]"
            >
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              <span>SVG</span>
            </button>
          </div>
        </div>

        <!-- Live WhatsApp Chat Bubble Preview Card -->
        <div
          class="flex flex-col justify-between rounded-2xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FBE6C2] dark:bg-[#152412] p-5 shadow-inner"
        >
          <div class="flex items-center gap-3 border-b border-[#76C457]/50 pb-3 mb-3">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#2A7C13] text-[#FFFFFF] shadow-sm">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </div>
            <div class="min-w-0">
              <div class="text-xs font-extrabold uppercase tracking-wider text-[#2A7C13] dark:text-[#76C457]">
                {t.generator.previewTitle}
              </div>
              <div class="truncate text-base font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]">
                <span id="preview-phone-number" class="font-mono text-[#2A7C13] dark:text-[#76C457]">+1</span>
              </div>
              <div class="flex items-center gap-1.5 text-xs font-bold text-[#3B5234] dark:text-[#FBE6C2]">
                <span class="inline-block h-2 w-2 rounded-full bg-[#2A7C13] dark:bg-[#76C457]"></span>
                <span>{t.generator.previewOnline}</span>
              </div>
            </div>
          </div>

          <div class="my-auto py-3 flex flex-col items-end">
            <div
              id="chat-bubble-container"
              data-placeholder={t.generator.previewPlaceholderBubble}
              class="animate-bubble-pop relative w-full rounded-2xl rounded-tr-sm border-2 border-[#76C457] bg-[#FFF8CF] dark:bg-[#1B2E17] px-4 py-3 text-base font-semibold text-[#1A2E15] dark:text-[#FFF8CF] shadow-sm"
            >
              <p id="preview-bubble-text" class="whitespace-pre-wrap break-words leading-relaxed">
                {t.generator.previewPlaceholderBubble}
              </p>
              <div class="mt-1.5 flex items-center justify-end gap-1 text-xs font-bold text-[#2A7C13] dark:text-[#76C457]">
                <span id="preview-timestamp">12:00</span>
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12" />
                  <polyline points="22 10 13 19 11 17" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Saved Links History (Compact Collapsible inside Result Area) -->
      <details class="group rounded-2xl border-2 border-[#76C457]/60 dark:border-[#2A7C13] bg-[#FFF8CF]/60 dark:bg-[#152412] p-4">
        <summary class="flex cursor-pointer list-none items-center justify-between text-sm sm:text-base font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]">
          <span class="flex items-center gap-2">
            <svg class="h-5 w-5 text-[#2A7C13] dark:text-[#76C457]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <span>{t.hero.modeHistory}</span>
            <span
              id="history-count-badge"
              class="inline-flex h-5 min-w-[20px] items-center justify-center rounded-full bg-[#2A7C13] px-1.5 text-xs font-extrabold text-[#FFFFFF]"
            >
              0
            </span>
          </span>
          <svg class="h-5 w-5 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </summary>

        <div class="mt-4 space-y-3 pt-3 border-t border-[#76C457]/40">
          <div class="flex items-center justify-between gap-2">
            <p class="text-xs font-semibold text-[#3B5234] dark:text-[#FBE6C2]">
              {t.generator.historySubheading}
            </p>
            <button
              type="button"
              id="clear-history-btn"
              class="rounded-lg border border-[#2A7C13] bg-[#FBE6C2] dark:bg-[#243B1F] px-2.5 py-1 text-xs font-extrabold text-[#1A2E15] dark:text-[#FFF8CF] hover:bg-[#2A7C13] hover:text-[#FFFFFF] transition-colors"
            >
              {t.generator.historyClearBtn}
            </button>
          </div>
          <div
            id="history-list-container"
            data-empty-text={t.generator.historyEmpty}
            data-load-label={t.generator.historyLoadBtn}
            data-copy-label={t.generator.historyCopyBtn}
            class="space-y-2"
          ></div>
        </div>
      </details>
    </div>
  </div>
</section>

<script>
  import QRCode from 'qrcode';

  interface SavedLinkItem {
    dial: string;
    iso: string;
    phone: string;
    message: string;
    url: string;
    timestamp: string;
  }

  const STORAGE_KEY = 'whatzplink_history_v1';

  function sanitizePhoneNumber(raw: string): { cleaned: string; hadInvalidChars: boolean } {
    const withoutFormatting = raw.replace(/[\s\-\(\)\+\.]/g, '');
    const digitsOnly = withoutFormatting.replace(/\D/g, '');
    const strippedLeadingZeros = digitsOnly.replace(/^0+/, '');
    const hadInvalidChars = raw !== strippedLeadingZeros && raw.length > 0;
    return { cleaned: strippedLeadingZeros, hadInvalidChars };
  }

  function buildWaMeUrl(dial: string, cleanPhone: string, message: string): string {
    const cleanDial = dial.replace(/\D/g, '');
    const fullNumber = `${cleanDial}${cleanPhone}`;
    const trimmedMessage = message.trim();
    if (!trimmedMessage) {
      return `https://wa.me/${fullNumber}`;
    }
    return `https://wa.me/${fullNumber}?text=${encodeURIComponent(trimmedMessage)}`;
  }

  function initWhatsAppGenerator() {
    let selectedDial = '1';
    let selectedIso = 'US';
    let latestSvgString = '';
    let isResultVisible = false;

    const workspaceBox = document.getElementById('generator-workspace-box');
    const form = document.getElementById('wa-generator-form');
    const resultsSection = document.getElementById('generated-results-section');

    const countryBtn = document.getElementById('country-selector-btn');
    const countryDisplay = document.getElementById('selected-country-display');
    const countryPanel = document.getElementById('country-dropdown-panel');
    const countrySearch = document.getElementById('country-search-input') as HTMLInputElement | null;
    const countryWrapper = document.getElementById('country-selector-wrapper');
    const countryOptions = document.querySelectorAll('.country-option-item');

    const phoneInput = document.getElementById('wa-phone-input') as HTMLInputElement | null;
    const messageInput = document.getElementById('wa-message-input') as HTMLTextAreaElement | null;
    const validationBadge = document.getElementById('phone-validation-badge');
    const validationText = document.getElementById('validation-status-text');
    const validationDot = document.getElementById('validation-icon-dot');

    const previewPhone = document.getElementById('preview-phone-number');
    const previewBubbleText = document.getElementById('preview-bubble-text');
    const chatBubbleContainer = document.getElementById('chat-bubble-container');
    const previewTimestamp = document.getElementById('preview-timestamp');

    const qrCanvas = document.getElementById('wa-qr-canvas') as HTMLCanvasElement | null;
    const urlReadout = document.getElementById('generated-url-readout');
    const copyBtn = document.getElementById('copy-wa-link-btn');
    const copyBtnLabel = document.getElementById('copy-btn-label');
    const downloadPngBtn = document.getElementById('download-qr-png-btn');
    const downloadSvgBtn = document.getElementById('download-qr-svg-btn');
    const testWaBtn = document.getElementById('test-wa-link-btn') as HTMLAnchorElement | null;

    const historyBadge = document.getElementById('history-count-badge');
    const historyContainer = document.getElementById('history-list-container');
    const clearHistoryBtn = document.getElementById('clear-history-btn');

    if (previewTimestamp) {
      const now = new Date();
      previewTimestamp.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    async function renderQrCode(url: string) {
      if (!qrCanvas) return;
      try {
        await QRCode.toCanvas(qrCanvas, url, {
          width: 200,
          margin: 1,
          color: {
            dark: '#1A2E15',
            light: '#FFFFFF',
          },
          errorCorrectionLevel: 'M',
        });
        latestSvgString = await QRCode.toString(url, {
          type: 'svg',
          width: 512,
          margin: 2,
          color: {
            dark: '#2A7C13',
            light: '#FFFFFF',
          },
          errorCorrectionLevel: 'M',
        });
      } catch (err) {
        console.error('QR generation error:', err);
      }
    }

    function updateEngine(showValidation = false) {
      if (!phoneInput || !messageInput) return false;

      const rawPhone = phoneInput.value;
      const { cleaned, hadInvalidChars } = sanitizePhoneNumber(rawPhone);
      const isValid = cleaned.length >= 6;

      if (validationBadge && validationText && validationDot) {
        if (showValidation || rawPhone.trim().length > 0) {
          validationBadge.classList.remove('hidden');
          validationBadge.classList.add('flex');

          if (!rawPhone.trim()) {
            validationText.textContent = validationBadge.getAttribute('data-empty') || '';
            validationDot.textContent = '!';
            validationDot.className = 'flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#3B5234] text-xs text-[#FFF8CF]';
          } else if (!isValid) {
            validationText.textContent = validationBadge.getAttribute('data-invalid') || '';
            validationDot.textContent = '!';
            validationDot.className = 'flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#3B5234] text-xs text-[#FFF8CF]';
          } else if (hadInvalidChars) {
            validationText.textContent = validationBadge.getAttribute('data-cleaned') || '';
            validationDot.textContent = '✓';
            validationDot.className = 'flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#2A7C13] text-xs text-[#FFFFFF]';
          } else {
            validationText.textContent = validationBadge.getAttribute('data-ready') || '';
            validationDot.textContent = '✓';
            validationDot.className = 'flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#2A7C13] text-xs text-[#FFFFFF]';
          }
        }
      }

      if (!isValid && !isResultVisible) {
        return false;
      }

      const safePhone = cleaned || '2345678900';
      const msg = messageInput.value;
      const fullUrl = buildWaMeUrl(selectedDial, safePhone, msg);

      if (previewPhone) {
        previewPhone.textContent = `+${selectedDial} ${safePhone}`;
      }

      if (previewBubbleText && chatBubbleContainer) {
        const placeholder = chatBubbleContainer.getAttribute('data-placeholder') || '';
        previewBubbleText.textContent = msg.trim() ? msg : placeholder;
      }

      if (urlReadout) {
        urlReadout.textContent = fullUrl;
      }
      if (testWaBtn) {
        testWaBtn.href = fullUrl;
      }

      renderQrCode(fullUrl);
      return isValid;
    }

    // Handle Form Submit ("Create wa.me Link & QR" Button)
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!phoneInput) return;

      const isValid = updateEngine(true);
      if (!isValid) {
        phoneInput.focus();
        phoneInput.classList.remove('animate-pulse-emerald');
        void phoneInput.offsetWidth;
        phoneInput.classList.add('animate-pulse-emerald');
        return;
      }

      isResultVisible = true;
      workspaceBox?.classList.remove('max-w-2xl');
      workspaceBox?.classList.add('max-w-3xl');
      resultsSection?.classList.remove('hidden');
      saveCurrentLinkToHistory();

      setTimeout(() => {
        resultsSection?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }, 80);
    });

    // Country Selector Dropdown
    if (countryBtn && countryPanel && countryWrapper) {
      countryBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = countryPanel.classList.contains('hidden');
        countryPanel.classList.toggle('hidden', !isHidden);
        countryBtn.setAttribute('aria-expanded', String(isHidden));
        if (isHidden && countrySearch) {
          setTimeout(() => countrySearch.focus(), 50);
        }
      });

      document.addEventListener('click', (e) => {
        if (!countryWrapper.contains(e.target as Node)) {
          countryPanel.classList.add('hidden');
          countryBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    if (countrySearch) {
      countrySearch.addEventListener('input', () => {
        const query = countrySearch.value.trim().toLowerCase().replace(/^\+/, '');
        countryOptions.forEach((item) => {
          const name = item.getAttribute('data-name') || '';
          const dial = item.getAttribute('data-dial') || '';
          const code = item.getAttribute('data-code') || '';
          const matches = name.includes(query) || dial.includes(query) || code.includes(query);
          (item as HTMLElement).style.display = matches ? 'flex' : 'none';
        });
      });
    }

    countryOptions.forEach((item) => {
      item.addEventListener('click', () => {
        selectedDial = item.getAttribute('data-dial') || '1';
        selectedIso = item.getAttribute('data-iso') || 'US';
        if (countryDisplay) {
          countryDisplay.innerHTML = `<span class="inline-flex items-center justify-center rounded-md bg-[#2A7C13] px-1.5 py-0.5 text-xs font-extrabold text-[#FFFFFF]">${selectedIso}</span><span>+${selectedDial}</span>`;
        }
        countryPanel?.classList.add('hidden');
        countryBtn?.setAttribute('aria-expanded', 'false');
        if (isResultVisible) updateEngine(false);
      });
    });

    // Live updates if results section is already open
    phoneInput?.addEventListener('input', () => {
      if (isResultVisible || (phoneInput.value.trim().length > 0)) {
        updateEngine(false);
      }
    });
    messageInput?.addEventListener('input', () => {
      if (isResultVisible) updateEngine(false);
    });

    // 1-Click Quick Chips
    const quickChips = document.querySelectorAll('.quick-chip-btn');
    quickChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const chipText = chip.getAttribute('data-chip-text') || '';
        if (messageInput) {
          messageInput.value = chipText;
          messageInput.classList.remove('animate-pulse-emerald');
          void messageInput.offsetWidth;
          messageInput.classList.add('animate-pulse-emerald');
          if (isResultVisible) updateEngine(false);
        }
      });
    });

    // LocalStorage History Management
    function loadHistory(): SavedLinkItem[] {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return [];
        const parsed = JSON.parse(raw);
        return Array.isArray(parsed) ? parsed.slice(0, 5) : [];
      } catch {
        return [];
      }
    }

    function saveCurrentLinkToHistory() {
      if (!phoneInput || !messageInput) return;
      const { cleaned } = sanitizePhoneNumber(phoneInput.value);
      if (cleaned.length < 6) return;
      const msg = messageInput.value.trim();
      const url = buildWaMeUrl(selectedDial, cleaned, msg);

      const currentList = loadHistory().filter((item) => item.url !== url);
      const newItem: SavedLinkItem = {
        dial: selectedDial,
        iso: selectedIso,
        phone: cleaned,
        message: msg,
        url,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      };

      const updated = [newItem, ...currentList].slice(0, 5);
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
      } catch {}
      renderHistoryList();
    }

    function renderHistoryList() {
      const items = loadHistory();
      if (historyBadge) {
        historyBadge.textContent = String(items.length);
      }
      if (!historyContainer) return;

      const emptyText = historyContainer.getAttribute('data-empty-text') || 'No links saved yet.';
      const loadLabel = historyContainer.getAttribute('data-load-label') || 'Load';
      const copyLabel = historyContainer.getAttribute('data-copy-label') || 'Copy';

      if (items.length === 0) {
        historyContainer.innerHTML = `
          <div class="rounded-xl border border-dashed border-[#76C457] bg-[#FFFFFF] dark:bg-[#1B2E17] p-4 text-center text-sm font-bold text-[#3B5234] dark:text-[#FBE6C2]">
            ${emptyText}
          </div>
        `;
        return;
      }

      historyContainer.innerHTML = items
        .map(
          (item, idx) => `
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 rounded-xl border border-[#76C457] bg-[#FFFFFF] dark:bg-[#1B2E17] p-3">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 text-sm font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]">
                <span class="rounded bg-[#2A7C13] px-1.5 py-0.5 text-[10px] text-[#FFFFFF]">${item.iso || 'WA'}</span>
                <span>+${item.dial} ${item.phone}</span>
                <span class="text-xs font-semibold text-[#3B5234] dark:text-[#FBE6C2]">• ${item.timestamp}</span>
              </div>
              <div class="truncate font-mono text-xs font-bold text-[#2A7C13] dark:text-[#76C457]">
                ${item.url}
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <button
                type="button"
                data-history-idx="${idx}"
                class="history-load-item-btn rounded-lg border border-[#2A7C13] bg-[#FBE6C2] dark:bg-[#243B1F] px-3 py-1.5 text-xs font-extrabold text-[#1A2E15] dark:text-[#FFF8CF] hover:bg-[#2A7C13] hover:text-[#FFFFFF] transition-colors"
              >
                ${loadLabel}
              </button>
              <button
                type="button"
                data-history-url="${item.url}"
                class="history-copy-item-btn rounded-lg bg-[#2A7C13] px-3 py-1.5 text-xs font-extrabold text-[#FFFFFF] hover:shadow-emerald-glow transition-all"
              >
                ${copyLabel}
              </button>
            </div>
          </div>
        `
        )
        .join('');

      historyContainer.querySelectorAll('.history-load-item-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.getAttribute('data-history-idx') || '0');
          const target = items[idx];
          if (target && phoneInput && messageInput) {
            selectedDial = target.dial;
            selectedIso = target.iso || 'US';
            if (countryDisplay) {
              countryDisplay.innerHTML = `<span class="inline-flex items-center justify-center rounded-md bg-[#2A7C13] px-1.5 py-0.5 text-xs font-extrabold text-[#FFFFFF]">${selectedIso}</span><span>+${selectedDial}</span>`;
            }
            phoneInput.value = target.phone;
            messageInput.value = target.message;
            updateEngine(true);
          }
        });
      });

      historyContainer.querySelectorAll('.history-copy-item-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const url = btn.getAttribute('data-history-url') || '';
          try {
            await navigator.clipboard.writeText(url);
            const original = btn.textContent;
            btn.textContent = '✓';
            setTimeout(() => {
              btn.textContent = original;
            }, 1500);
          } catch {}
        });
      });
    }

    clearHistoryBtn?.addEventListener('click', () => {
      try {
        localStorage.removeItem(STORAGE_KEY);
      } catch {}
      renderHistoryList();
    });

    // Copy Link Button
    copyBtn?.addEventListener('click', async () => {
      const url = urlReadout?.textContent?.trim() || '';
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const temp = document.createElement('textarea');
        temp.value = url;
        document.body.appendChild(temp);
        temp.select();
        document.execCommand('copy');
        document.body.removeChild(temp);
      }

      saveCurrentLinkToHistory();

      if (copyBtnLabel && copyBtn) {
        const copyText = copyBtn.getAttribute('data-copy-text') || 'Copy WhatsApp Link';
        const copiedText = copyBtn.getAttribute('data-copied-text') || 'Copied!';
        const copyBanner = document.getElementById('copy-notification-banner');
        copyBtnLabel.textContent = copiedText;
        copyBtn.classList.add('ring-4', 'ring-[#76C457]');
        if (copyBanner) {
          copyBanner.textContent = copiedText;
          copyBanner.classList.remove('hidden');
        }
        setTimeout(() => {
          copyBtnLabel.textContent = copyText;
          copyBtn.classList.remove('ring-4', 'ring-[#76C457]');
          copyBanner?.classList.add('hidden');
        }, 2200);
      }
    });

    testWaBtn?.addEventListener('click', () => {
      saveCurrentLinkToHistory();
    });

    // Download QR Code (PNG)
    downloadPngBtn?.addEventListener('click', async () => {
      const url = urlReadout?.textContent?.trim() || 'https://wa.me/12345678900';
      const exportCanvas = document.createElement('canvas');
      await QRCode.toCanvas(exportCanvas, url, {
        width: 1024,
        margin: 2,
        color: {
          dark: '#1A2E15',
          light: '#FFFFFF',
        },
        errorCorrectionLevel: 'H',
      });
      const dataUrl = exportCanvas.toDataURL('image/png');
      const link = document.createElement('a');
      link.download = `whatzplink-qr-${selectedDial}.png`;
      link.href = dataUrl;
      link.click();
      saveCurrentLinkToHistory();
    });

    // Download QR Code (SVG)
    downloadSvgBtn?.addEventListener('click', () => {
      if (!latestSvgString) return;
      const blob = new Blob([latestSvgString], { type: 'image/svg+xml;charset=utf-8' });
      const blobUrl = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.download = `whatzplink-qr-${selectedDial}.svg`;
      link.href = blobUrl;
      link.click();
      setTimeout(() => URL.revokeObjectURL(blobUrl), 1000);
      saveCurrentLinkToHistory();
    });

    renderHistoryList();
  }

  initWhatsAppGenerator();
</script>
