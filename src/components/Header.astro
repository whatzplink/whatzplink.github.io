---
import { languages, type Lang, useTranslations, getLocalizedPath } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentLangMeta = languages[lang];
---

<header
  class="sticky top-0 z-50 w-full border-b-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FFF8CF]/95 dark:bg-[#0D170B]/95 backdrop-blur-md transition-colors duration-200"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-2 px-3 py-2 sm:px-5 lg:px-6 lg:py-2.5">
    <!-- 1. Brand Logo + Title -->
    <a
      href={getLocalizedPath(lang)}
      aria-label={t.nav.brand}
      class="group flex shrink-0 items-center gap-2.5 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#2A7C13] dark:focus:ring-[#76C457]"
    >
      <div
        class="flex h-11 w-11 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-xl bg-[#2A7C13] text-[#FFFFFF] shadow-sm transition-transform duration-200 group-hover:scale-105 group-hover:shadow-emerald-glow"
      >
        <svg
          class="h-6 w-6 sm:h-7 sm:w-7"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          <path d="M10 14l4-4" />
          <path d="M9.5 11.5L8 10a1.5 1.5 0 0 1 2.1-2.1l1.5 1.5" />
          <path d="M14.5 12.5L16 14a1.5 1.5 0 0 1-2.1 2.1l-1.5-1.5" />
        </svg>
      </div>
      <span class="text-xl sm:text-2xl font-extrabold tracking-tight text-[#1A2E15] dark:text-[#FFF8CF]">
        {t.nav.brand}
      </span>
    </a>

    <!-- Right Action Controls (Icon-Only + Menu Toggle on Mobile/Tablet <1024px, Full Labels on Desktop >=1024px) -->
    <nav class="flex items-center gap-1.5 sm:gap-2 lg:gap-3" aria-label="Main Navigation">
      <!-- 2. 8-Language Dropdown Selector (Icon-only on mobile & tablet, text on lg+) -->
      <div class="relative" id="lang-dropdown-wrapper">
        <button
          type="button"
          id="lang-dropdown-btn"
          aria-label={t.nav.languageLabel}
          aria-haspopup="true"
          aria-expanded="false"
          class="flex h-11 w-11 sm:h-12 sm:w-12 lg:w-auto items-center justify-center gap-2 rounded-xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FBE6C2] dark:bg-[#152412] lg:px-3.5 text-[#1A2E15] dark:text-[#FFF8CF] font-bold transition-all duration-200 hover:border-[#2A7C13] dark:hover:border-[#76C457] hover:shadow-emerald-glow focus:outline-none focus:ring-2 focus:ring-[#2A7C13]"
        >
          <svg
            class="h-6 w-6 shrink-0 text-[#2A7C13] dark:text-[#76C457]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <line x1="2" y1="12" x2="22" y2="12" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          <span class="hidden lg:inline-flex items-center gap-1.5 text-sm font-bold whitespace-nowrap">
            <span>{currentLangMeta.flag}</span>
            <span>{currentLangMeta.code}</span>
          </span>
          <svg
            class="hidden lg:block h-4 w-4 shrink-0 opacity-75"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="lang-dropdown-menu"
          role="menu"
          aria-label={t.nav.languageLabel}
          class="hidden absolute right-0 mt-2 w-52 origin-top-right rounded-2xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FFFFFF] dark:bg-[#1B2E17] p-1.5 shadow-xl z-50"
        >
          {
            Object.entries(languages).map(([code, meta]) => {
              const isCurrent = code === lang;
              return (
                <a
                  href={getLocalizedPath(code as Lang)}
                  role="menuitem"
                  class={`flex items-center justify-between rounded-xl px-3 py-2.5 text-sm font-bold transition-colors ${
                    isCurrent
                      ? 'bg-[#2A7C13] text-[#FFFFFF]'
                      : 'text-[#1A2E15] dark:text-[#FFF8CF] hover:bg-[#FBE6C2] dark:hover:bg-[#243B1F]'
                  }`}
                >
                  <span class="flex items-center gap-2.5">
                    <span class="text-base">{meta.flag}</span>
                    <span>{meta.name}</span>
                  </span>
                  <span class="text-xs uppercase opacity-80">{meta.code}</span>
                </a>
              );
            })
          }
        </div>
      </div>

      <!-- 3. Light/Dark Mode Toggle Button (Icon-only 44x44 / 48x48) -->
      <button
        type="button"
        id="theme-toggle-btn"
        aria-label={t.nav.themeToggleLabel}
        class="flex h-11 w-11 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FBE6C2] dark:bg-[#152412] text-[#1A2E15] dark:text-[#FFF8CF] transition-all duration-200 hover:border-[#2A7C13] dark:hover:border-[#76C457] hover:shadow-emerald-glow focus:outline-none focus:ring-2 focus:ring-[#2A7C13]"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg
          id="theme-icon-sun"
          class="hidden dark:block h-6 w-6 text-[#FFF8CF]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg
          id="theme-icon-moon"
          class="block dark:hidden h-6 w-6 text-[#2A7C13]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      <!-- 4. Desktop Install PWA Button (Hidden on <1024px, available in toggle menu & icon bar) -->
      <button
        type="button"
        id="install-pwa-btn"
        aria-label={t.nav.installPwaAria}
        data-toast={t.nav.installPwaToast}
        class="hidden lg:flex h-12 items-center justify-center gap-2 rounded-xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FBE6C2] dark:bg-[#152412] px-3.5 text-[#1A2E15] dark:text-[#FFF8CF] font-bold transition-all duration-200 hover:border-[#2A7C13] dark:hover:border-[#76C457] hover:shadow-emerald-glow focus:outline-none focus:ring-2 focus:ring-[#2A7C13]"
      >
        <svg
          class="h-5 w-5 shrink-0 text-[#2A7C13] dark:text-[#76C457]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
          <line x1="12" y1="18" x2="12.01" y2="18" />
          <path d="M12 7v6" />
          <path d="M9.5 10.5L12 13l2.5-2.5" />
        </svg>
        <span class="text-sm font-bold whitespace-nowrap">
          {t.nav.installPwa}
        </span>
      </button>

      <!-- 5. Desktop CTA Button: 'Support the Developer' (Hidden on <1024px, shown in mobile/tablet toggle menu) -->
      <a
        href="https://kisharadilshan.gumroad.com/coffee"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.nav.supportDevAria}
        class="hidden lg:flex h-12 items-center justify-center gap-2 rounded-xl bg-[#2A7C13] px-4 text-[#FFFFFF] font-bold shadow-sm transition-all duration-200 hover:bg-[#2A7C13] hover:shadow-emerald-glow hover:ring-2 hover:ring-[#76C457] active:scale-95 focus:outline-none focus:ring-2 focus:ring-[#76C457]"
      >
        <svg
          class="h-5 w-5 shrink-0 text-[#FFFFFF]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
          <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
          <path d="M10 12.5c-.8-1-2.2-1-3 0-.7.9-.7 2.2 0 3l3 2.7 3-2.7c.7-.8.7-2.1 0-3-.8-1-2.2-1-3 0Z" fill="#76C457" stroke="none" />
        </svg>
        <span class="text-sm font-bold whitespace-nowrap">
          {t.nav.supportDev}
        </span>
      </a>

      <!-- 6. Mobile & Tablet Navbar Toggle Icon Button (< 1024px) -->
      <button
        type="button"
        id="mobile-menu-toggle-btn"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
        aria-controls="mobile-tablet-nav-drawer"
        class="flex lg:hidden h-11 w-11 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-xl border-2 border-[#2A7C13] bg-[#2A7C13] text-[#FFFFFF] shadow-sm transition-all duration-200 hover:shadow-emerald-glow focus:outline-none focus:ring-2 focus:ring-[#76C457]"
      >
        <!-- Hamburger Icon -->
        <svg
          id="menu-icon-open"
          class="block h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <!-- Close (X) Icon -->
        <svg
          id="menu-icon-close"
          class="hidden h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </nav>
  </div>

  <!-- Collapsible Mobile & Tablet Navigation Drawer (< 1024px) -->
  <div
    id="mobile-tablet-nav-drawer"
    class="hidden lg:hidden border-t-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FFF8CF] dark:bg-[#152412] px-4 py-4 shadow-xl"
  >
    <div class="mx-auto max-w-3xl space-y-4">
      <!-- Action Buttons Row in Drawer -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <button
          type="button"
          id="install-pwa-btn-mobile"
          aria-label={t.nav.installPwaAria}
          data-toast={t.nav.installPwaToast}
          class="flex min-h-[48px] w-full items-center justify-center gap-2.5 rounded-xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FBE6C2] dark:bg-[#1B2E17] px-4 py-2.5 text-base font-extrabold text-[#1A2E15] dark:text-[#FFF8CF] transition-all hover:border-[#2A7C13]"
        >
          <svg
            class="h-5 w-5 shrink-0 text-[#2A7C13] dark:text-[#76C457]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
            <line x1="12" y1="18" x2="12.01" y2="18" />
            <path d="M12 7v6" />
            <path d="M9.5 10.5L12 13l2.5-2.5" />
          </svg>
          <span>{t.nav.installPwa}</span>
        </button>

        <a
          href="https://kisharadilshan.gumroad.com/coffee"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.nav.supportDevAria}
          class="flex min-h-[48px] w-full items-center justify-center gap-2.5 rounded-xl bg-[#2A7C13] px-4 py-2.5 text-base font-extrabold text-[#FFFFFF] shadow-sm transition-all hover:shadow-emerald-glow"
        >
          <svg
            class="h-5 w-5 shrink-0 text-[#FFFFFF]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
            <path d="M10 12.5c-.8-1-2.2-1-3 0-.7.9-.7 2.2 0 3l3 2.7 3-2.7c.7-.8.7-2.1 0-3-.8-1-2.2-1-3 0Z" fill="#76C457" stroke="none" />
          </svg>
          <span>{t.nav.supportDev}</span>
        </a>
      </div>

      <!-- Quick 8-Language Grid inside Mobile/Tablet Toggle Menu -->
      <div class="space-y-2">
        <div class="text-xs font-extrabold uppercase tracking-wider text-[#3B5234] dark:text-[#FBE6C2]">
          {t.nav.languageLabel}
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          {
            Object.entries(languages).map(([code, meta]) => {
              const isCurrent = code === lang;
              return (
                <a
                  href={getLocalizedPath(code as Lang)}
                  class={`flex items-center gap-2 rounded-xl border px-3 py-2 text-sm font-bold transition-colors ${
                    isCurrent
                      ? 'border-[#2A7C13] bg-[#2A7C13] text-[#FFFFFF]'
                      : 'border-[#76C457] bg-[#FFFFFF] dark:bg-[#1B2E17] text-[#1A2E15] dark:text-[#FFF8CF] hover:bg-[#FBE6C2]'
                  }`}
                >
                  <span>{meta.flag}</span>
                  <span class="truncate">{meta.name}</span>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Banner for Install PWA -->
  <div
    id="pwa-toast-banner"
    role="status"
    aria-live="polite"
    class="hidden bg-[#2A7C13] text-[#FFFFFF] text-center text-sm font-semibold py-2 px-4 transition-all"
  >
  </div>
</header>

<script>
  function initHeaderControls() {
    // 1. Language Dropdown Toggle
    const langBtn = document.getElementById('lang-dropdown-btn');
    const langMenu = document.getElementById('lang-dropdown-menu');
    const langWrapper = document.getElementById('lang-dropdown-wrapper');

    if (langBtn && langMenu && langWrapper) {
      langBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = langMenu.classList.contains('hidden');
        langMenu.classList.toggle('hidden', !isHidden);
        langBtn.setAttribute('aria-expanded', String(isHidden));
      });

      document.addEventListener('click', (e) => {
        if (!langWrapper.contains(e.target as Node)) {
          langMenu.classList.add('hidden');
          langBtn.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          langMenu.classList.add('hidden');
          langBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // 2. Mobile & Tablet Drawer Toggle Button
    const mobileToggleBtn = document.getElementById('mobile-menu-toggle-btn');
    const mobileDrawer = document.getElementById('mobile-tablet-nav-drawer');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (mobileToggleBtn && mobileDrawer && iconOpen && iconClose) {
      mobileToggleBtn.addEventListener('click', () => {
        const isHidden = mobileDrawer.classList.contains('hidden');
        mobileDrawer.classList.toggle('hidden', !isHidden);
        iconOpen.classList.toggle('hidden', isHidden);
        iconClose.classList.toggle('hidden', !isHidden);
        mobileToggleBtn.setAttribute('aria-expanded', String(isHidden));
      });
    }

    // 3. Theme Toggle Button
    const themeBtn = document.getElementById('theme-toggle-btn');
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('whatzplink_theme', isDark ? 'dark' : 'light');
        } catch {}
        window.dispatchEvent(new CustomEvent('whatzplink:theme-change', { detail: { isDark } }));
      });
    }

    // 4. Install PWA ('Add to Home Screen') Buttons (Desktop + Mobile Drawer)
    let deferredPrompt: any = null;
    const installBtn = document.getElementById('install-pwa-btn');
    const installBtnMobile = document.getElementById('install-pwa-btn-mobile');
    const toastBanner = document.getElementById('pwa-toast-banner');

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
    });

    async function handleInstallClick(btnEl: HTMLElement) {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        await deferredPrompt.userChoice;
        deferredPrompt = null;
      } else if (toastBanner) {
        const msg = btnEl.getAttribute('data-toast') || 'Add WhatzpLink to your Home Screen!';
        toastBanner.textContent = msg;
        toastBanner.classList.remove('hidden');
        setTimeout(() => {
          toastBanner.classList.add('hidden');
        }, 4500);
      }
    }

    installBtn?.addEventListener('click', () => handleInstallClick(installBtn));
    installBtnMobile?.addEventListener('click', () => handleInstallClick(installBtnMobile));
  }

  initHeaderControls();
</script>
