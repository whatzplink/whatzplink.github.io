---
import { type Lang, useTranslations, getLocalizedPath, languages } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div id="business-tools" class="mx-auto max-w-6xl px-4 py-12 sm:px-6 space-y-16">
  <!-- 1:1 Visual Breadcrumb Navigation (Home > Business Tools > WhatsApp Link Generator) -->
  <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm sm:text-base font-bold text-[#3B5234] dark:text-[#FBE6C2]">
    <ol class="flex flex-wrap items-center gap-2">
      <li>
        <a href="https://whatzplink.github.io/" class="hover:text-[#2A7C13] dark:hover:text-[#76C457] underline-offset-4 hover:underline">
          {t.breadcrumbs.home}
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li>
        <a href={`${getLocalizedPath(lang)}#business-tools`} class="hover:text-[#2A7C13] dark:hover:text-[#76C457] underline-offset-4 hover:underline">
          {t.breadcrumbs.tools}
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-[#1A2E15] dark:text-[#FFF8CF] font-extrabold">
        {t.breadcrumbs.generator}
      </li>
    </ol>
  </nav>

  <!-- 3-Step How-To Section -->
  <section aria-labelledby="howto-heading" class="space-y-8">
    <div class="text-center max-w-3xl mx-auto space-y-2">
      <h2
        id="howto-heading"
        class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]"
      >
        {t.howTo.heading}
      </h2>
      <p class="text-lg font-medium text-[#3B5234] dark:text-[#FBE6C2]">
        {t.howTo.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Step 1 Card -->
      <article class="rounded-3xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FBE6C2] dark:bg-[#152412] p-6 space-y-3 shadow-sm">
        <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#2A7C13] text-[#FFFFFF]">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
        </div>
        <h3 class="text-xl font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]">
          {t.howTo.step1Title}
        </h3>
        <p class="text-base font-medium leading-relaxed text-[#3B5234] dark:text-[#FBE6C2]">
          {t.howTo.step1Desc}
        </p>
      </article>

      <!-- Step 2 Card -->
      <article class="rounded-3xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FBE6C2] dark:bg-[#152412] p-6 space-y-3 shadow-sm">
        <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#2A7C13] text-[#FFFFFF]">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
          </svg>
        </div>
        <h3 class="text-xl font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]">
          {t.howTo.step2Title}
        </h3>
        <p class="text-base font-medium leading-relaxed text-[#3B5234] dark:text-[#FBE6C2]">
          {t.howTo.step2Desc}
        </p>
      </article>

      <!-- Step 3 Card -->
      <article class="rounded-3xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FBE6C2] dark:bg-[#152412] p-6 space-y-3 shadow-sm">
        <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#2A7C13] text-[#FFFFFF]">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" />
            <rect x="14" y="3" width="7" height="7" />
            <rect x="14" y="14" width="7" height="7" />
            <rect x="3" y="14" width="7" height="7" />
          </svg>
        </div>
        <h3 class="text-xl font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]">
          {t.howTo.step3Title}
        </h3>
        <p class="text-base font-medium leading-relaxed text-[#3B5234] dark:text-[#FBE6C2]">
          {t.howTo.step3Desc}
        </p>
      </article>
    </div>
  </section>

  <!-- Keyword-Rich Semantic SEO Guide Section (<section>, <article>, <h2>, <h3>) -->
  <section aria-labelledby="seo-guide-heading" class="space-y-8">
    <div class="text-center max-w-3xl mx-auto space-y-2">
      <h2
        id="seo-guide-heading"
        class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]"
      >
        {t.seoGuide.heading}
      </h2>
      <p class="text-lg font-medium text-[#3B5234] dark:text-[#FBE6C2]">
        {t.seoGuide.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <article class="rounded-3xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FFFFFF] dark:bg-[#1B2E17] p-6 space-y-3 shadow-sm">
        <h3 class="text-xl font-extrabold text-[#2A7C13] dark:text-[#76C457]">
          {t.seoGuide.article1Title}
        </h3>
        <p class="text-base font-medium leading-relaxed text-[#1A2E15] dark:text-[#FFF8CF]">
          {t.seoGuide.article1Body}
        </p>
      </article>

      <article class="rounded-3xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FFFFFF] dark:bg-[#1B2E17] p-6 space-y-3 shadow-sm">
        <h3 class="text-xl font-extrabold text-[#2A7C13] dark:text-[#76C457]">
          {t.seoGuide.article2Title}
        </h3>
        <p class="text-base font-medium leading-relaxed text-[#1A2E15] dark:text-[#FFF8CF]">
          {t.seoGuide.article2Body}
        </p>
      </article>

      <article class="rounded-3xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FFFFFF] dark:bg-[#1B2E17] p-6 space-y-3 shadow-sm">
        <h3 class="text-xl font-extrabold text-[#2A7C13] dark:text-[#76C457]">
          {t.seoGuide.article3Title}
        </h3>
        <p class="text-base font-medium leading-relaxed text-[#1A2E15] dark:text-[#FFF8CF]">
          {t.seoGuide.article3Body}
        </p>
      </article>
    </div>
  </section>

  <!-- Comparison Table Section -->
  <section aria-labelledby="comparison-heading" class="space-y-8">
    <div class="text-center max-w-3xl mx-auto space-y-2">
      <h2
        id="comparison-heading"
        class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]"
      >
        {t.comparison.heading}
      </h2>
      <p class="text-lg font-medium text-[#3B5234] dark:text-[#FBE6C2]">
        {t.comparison.subtitle}
      </p>
    </div>

    <div class="overflow-x-auto rounded-3xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FFFFFF] dark:bg-[#1B2E17] shadow-sm">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FBE6C2] dark:bg-[#152412]">
            <th scope="col" class="p-4 sm:p-5 text-base font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]">
              {t.comparison.colFeature}
            </th>
            <th scope="col" class="p-4 sm:p-5 text-base font-extrabold text-[#2A7C13] dark:text-[#76C457]">
              ✓ {t.comparison.colWhatzpLink}
            </th>
            <th scope="col" class="p-4 sm:p-5 text-base font-bold text-[#3B5234] dark:text-[#FBE6C2]">
              {t.comparison.colManual}
            </th>
            <th scope="col" class="p-4 sm:p-5 text-base font-bold text-[#3B5234] dark:text-[#FBE6C2]">
              {t.comparison.colShorteners}
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#FBE6C2] dark:divide-[#243B1F] text-sm sm:text-base font-semibold">
          <tr>
            <td class="p-4 sm:p-5 font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]">{t.comparison.row1Feature}</td>
            <td class="p-4 sm:p-5 font-extrabold text-[#2A7C13] dark:text-[#76C457]">{t.comparison.row1Whatzp}</td>
            <td class="p-4 sm:p-5 text-[#3B5234] dark:text-[#FBE6C2]">{t.comparison.row1Manual}</td>
            <td class="p-4 sm:p-5 text-[#3B5234] dark:text-[#FBE6C2]">{t.comparison.row1Short}</td>
          </tr>
          <tr>
            <td class="p-4 sm:p-5 font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]">{t.comparison.row2Feature}</td>
            <td class="p-4 sm:p-5 font-extrabold text-[#2A7C13] dark:text-[#76C457]">{t.comparison.row2Whatzp}</td>
            <td class="p-4 sm:p-5 text-[#3B5234] dark:text-[#FBE6C2]">{t.comparison.row2Manual}</td>
            <td class="p-4 sm:p-5 text-[#3B5234] dark:text-[#FBE6C2]">{t.comparison.row2Short}</td>
          </tr>
          <tr>
            <td class="p-4 sm:p-5 font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]">{t.comparison.row3Feature}</td>
            <td class="p-4 sm:p-5 font-extrabold text-[#2A7C13] dark:text-[#76C457]">{t.comparison.row3Whatzp}</td>
            <td class="p-4 sm:p-5 text-[#3B5234] dark:text-[#FBE6C2]">{t.comparison.row3Manual}</td>
            <td class="p-4 sm:p-5 text-[#3B5234] dark:text-[#FBE6C2]">{t.comparison.row3Short}</td>
          </tr>
          <tr>
            <td class="p-4 sm:p-5 font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]">{t.comparison.row4Feature}</td>
            <td class="p-4 sm:p-5 font-extrabold text-[#2A7C13] dark:text-[#76C457]">{t.comparison.row4Whatzp}</td>
            <td class="p-4 sm:p-5 text-[#3B5234] dark:text-[#FBE6C2]">{t.comparison.row4Manual}</td>
            <td class="p-4 sm:p-5 text-[#3B5234] dark:text-[#FBE6C2]">{t.comparison.row4Short}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- SEO FAQ Section (Mapped 1:1 to FAQPage Schema) -->
  <section aria-labelledby="faq-heading" class="space-y-8">
    <div class="text-center max-w-3xl mx-auto space-y-2">
      <h2
        id="faq-heading"
        class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]"
      >
        {t.faq.heading}
      </h2>
      <p class="text-lg font-medium text-[#3B5234] dark:text-[#FBE6C2]">
        {t.faq.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <article class="rounded-3xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FFFFFF] dark:bg-[#1B2E17] p-6 space-y-2">
        <h3 class="text-lg font-extrabold text-[#2A7C13] dark:text-[#76C457]">
          {t.faq.q1}
        </h3>
        <p class="text-base font-medium leading-relaxed text-[#1A2E15] dark:text-[#FFF8CF]">
          {t.faq.a1}
        </p>
      </article>

      <article class="rounded-3xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FFFFFF] dark:bg-[#1B2E17] p-6 space-y-2">
        <h3 class="text-lg font-extrabold text-[#2A7C13] dark:text-[#76C457]">
          {t.faq.q2}
        </h3>
        <p class="text-base font-medium leading-relaxed text-[#1A2E15] dark:text-[#FFF8CF]">
          {t.faq.a2}
        </p>
      </article>

      <article class="rounded-3xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FFFFFF] dark:bg-[#1B2E17] p-6 space-y-2">
        <h3 class="text-lg font-extrabold text-[#2A7C13] dark:text-[#76C457]">
          {t.faq.q3}
        </h3>
        <p class="text-base font-medium leading-relaxed text-[#1A2E15] dark:text-[#FFF8CF]">
          {t.faq.a3}
        </p>
      </article>

      <article class="rounded-3xl border-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FFFFFF] dark:bg-[#1B2E17] p-6 space-y-2">
        <h3 class="text-lg font-extrabold text-[#2A7C13] dark:text-[#76C457]">
          {t.faq.q4}
        </h3>
        <p class="text-base font-medium leading-relaxed text-[#1A2E15] dark:text-[#FFF8CF]">
          {t.faq.a4}
        </p>
      </article>
    </div>
  </section>
</div>

<!-- Footer -->
<footer class="border-t-2 border-[#76C457] dark:border-[#2A7C13] bg-[#FBE6C2] dark:bg-[#152412] py-10 px-4">
  <div class="mx-auto max-w-6xl flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
    <div class="space-y-1">
      <div class="text-xl font-extrabold text-[#1A2E15] dark:text-[#FFF8CF]">
        {t.nav.brand}
      </div>
      <p class="text-sm font-bold text-[#3B5234] dark:text-[#FBE6C2]">
        {t.footer.tagline}
      </p>
      <p class="text-xs font-semibold text-[#2A7C13] dark:text-[#76C457]">
        {t.footer.privacyNote}
      </p>
    </div>

    <!-- Language Links in Footer for SEO Crawlability -->
    <div class="flex flex-wrap items-center justify-center gap-2">
      {
        Object.entries(languages).map(([code, meta]) => (
          <a
            href={getLocalizedPath(code as Lang)}
            class={`rounded-xl px-3 py-1.5 text-xs font-extrabold transition-colors ${
              code === lang
                ? 'bg-[#2A7C13] text-[#FFFFFF]'
                : 'bg-[#FFF8CF] dark:bg-[#1B2E17] text-[#1A2E15] dark:text-[#FFF8CF] hover:bg-[#76C457]'
            }`}
          >
            {meta.flag} {meta.name}
          </a>
        ))
      }
    </div>

    <div class="text-xs font-bold text-[#3B5234] dark:text-[#FBE6C2]">
      {t.footer.copyright}
    </div>
  </div>
</footer>
